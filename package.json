{
  "name": "rev-review",
  "version": "0.1.0",
  "private": true,
  "description": "A native GPUI diff review desk for humans and local agents.",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
