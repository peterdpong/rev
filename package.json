{
  "name": "patch-review",
  "version": "0.1.0",
  "private": true,
  "description": "A native GPUI diff review desk and CLI for humans and local agents.",
  "type": "module",
  "bin": {
    "patch": "bin/patch.mjs"
  },
  "scripts": {
    "build:host": "tsc --noEmit && node scripts/build.mjs",
    "build": "npm run build:host && cargo build --release",
    "start": "npm run build:host && cargo run -- open",
    "dev": "npm start",
    "bundle": "npm run build:host && node scripts/bundle.mjs",
    "cli": "node --import tsx src/cli.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:native": "cargo test --locked",
    "check": "tsc --noEmit",
    "demo": "node --import tsx scripts/demo.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
