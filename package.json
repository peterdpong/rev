{
  "name": "rev-review",
  "version": "0.1.0",
  "private": true,
  "description": "A native GPUI diff review desk for humans and local agents.",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "build:host": "tsc --noEmit && node scripts/build.mjs",
    "start": "npm run build:host && cargo run --bin rev --",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run build:host && cargo build --release --locked",
    "bundle": "npm run build:host && node scripts/bundle.mjs",
    "test:native": "cargo test --locked"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "prettier": "3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
